{
    "name": "aziontech/azionapi-php-sdk-test-harness",
    "description": "Shared runtime dependencies of the generated SDK packages, for the functional tests",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^2.0"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
